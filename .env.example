# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交到版本库
# Render 部署时无需上传本文件，请在 Render 控制台填写对应环境变量

# LLM（OpenAI 兼容接口）
OPENAI_API_KEY=
URL=https://api.deepseek.com
MODEL=deepseek-flash

# 高德 Web 服务 Key
GAODE_API_KEY=
# 可选：高德调用限速，按 Key 配额调整（个人 Key 通常 3 QPS）
GAODE_QPS=3
GAODE_MAX_INFLIGHT=3
AMAP_POOL_SIZE=8

# 飞猪技能 Key
FLYAI_API_KEY=

# 本地 docker compose 对外端口
WEB_PORT=3000
# 仅在受信任反向代理后面设为 1；直连部署保持 0，避免伪造 X-Forwarded-For
TRUST_PROXY=0
