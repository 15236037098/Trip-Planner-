# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交到版本库
# 阿里云 ECS 部署：配合 deploy/nginx/trip-planner.conf 使用

# LLM（OpenAI 兼容接口）
OPENAI_API_KEY=
URL=https://api.deepseek.com
MODEL=deepseek-flash

# 高德 Web 服务 Key
GAODE_API_KEY=
# 可选：高德调用限速，按 Key 配额调整（个人 Key 通常 3 QPS）
GAODE_QPS=3
GAODE_MAX_INFLIGHT=3
AMAP_POOL_SIZE=8

# 飞猪技能 Key
FLYAI_API_KEY=

# 本地 docker compose 对外端口（Nginx 反代到 127.0.0.1:3000）
WEB_PORT=3000
# 阿里云 ECS + Nginx 部署设为 1（信任一层代理）
# 若前面还有 SLB/CDN，按代理层数调大；无反向代理直连时设为 0
TRUST_PROXY=1

# 可选容量参数（不填时使用括号内默认值）
# CHAT_TIMEOUT_MS=20000
# MAX_INFLIGHT_CHAT=250
# MAX_QUEUE_CHAT=250
# MAX_INFLIGHT_PER_CLIENT=4
# CHAT_RATE_LIMIT_PER_MIN=30
# CHAT_BUDGET_SECONDS=18
# LLM_MAX_TOKENS=800
# MAX_CONCURRENT_LLM=200
# MAX_CONCURRENT_TOOLS=40
# IP_RATE_LIMIT=300
# FLYAI_PRODUCT_CONCURRENCY=2
# FLYAI_HOTEL_CONCURRENCY=2
# FLYAI_TRANSPORT_CONCURRENCY=1
# FLYAI_QUEUE_SIZE=100
# FLYAI_QUEUE_TIMEOUT_MS=3000
# FLYAI_JSON_TIMEOUT_MS=9000
